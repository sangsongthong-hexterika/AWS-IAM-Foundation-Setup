{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ListAdministrativeRecords",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::hexterika-hospital-records",
            "Condition": {
                "StringLike": {
                    "s3:prefix": [
                        "administrative/*"
                    ]
                }
            }
        },
        {
            "Sid": "ReadAdministrativeRecords",
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::hexterika-hospital-records/administrative/*"
        },
        {
            "Sid": "WriteAdministrativeRecords",
            "Effect": "Allow",
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::hexterika-hospital-records/administrative/*"
        }
    ]
}
